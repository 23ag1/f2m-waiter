# PremiumBonus API — переменные окружения
# Скопируй в .env и заполни значениями

# Обязательно: токен из личного кабинета PremiumBonus
PREMIUMBONUS_API_TOKEN=your_token_here

# Опционально: если нужен нестандартный URL
PREMIUMBONUS_BASE_URL=https://api.premiumbonus.su/v2

# Опционально: UUID точки продаж (если токен без привязки к точке)
PREMIUMBONUS_SALE_POINT_ID=
