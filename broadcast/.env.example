# ---- Внешние порты (host) ----
# По умолчанию локальные значения. На общих серверах переопределяйте,
# чтобы не конфликтовать с другими контейнерами.
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=broadcast

# ---- Mock-режим ----
# true — встроенный mock LLM (без интернета, мгновенно). Идеально для демо.
# false — реальный DeepSeek API (нужен ключ ниже).
MOCK_LLM=true
MOCK_LLM_DELAY_MIN_MS=70
MOCK_LLM_DELAY_MAX_MS=140

# ---- LLM (DeepSeek) — используется только если MOCK_LLM=false ----
# Получить ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ---- Telegram Bot (опционально) ----
# Нужен только для реальной отправки через /send.
# Для превью и демо-тыканья — не требуется.
BOT_TOKEN=
